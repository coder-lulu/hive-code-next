{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hive.dev/hiverelay/v2/fixture-manifest.schema.json",
  "title": "HiveRelay authority file manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractRevision", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractRevision": {"const": "hiverelay-v2-p0.3"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind", "applicableComponents", "sha256"],
            "properties": {
              "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9._/-]+$"},
              "kind": {"enum": ["documentation", "openapi", "schema", "registry"]},
              "applicableComponents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["cloud", "hivecode", "cell", "legacy-orca"]}},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind", "applicableComponents", "sha256", "caseId", "expectedVerdict", "expectedReason"],
            "properties": {
              "path": {"type": "string", "pattern": "^fixtures/[A-Za-z0-9._/-]+\\.json$"},
              "kind": {"const": "fixture"},
              "applicableComponents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["cloud", "hivecode", "cell", "legacy-orca"]}},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "caseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"},
              "expectedVerdict": {"enum": ["ACCEPT", "REJECT"]},
              "expectedReason": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}
            }
          }
        ]
      }
    }
  }
}
