{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hive.dev/hiverelay/v2/token-claims.schema.json",
  "title": "HiveRelay decoded strict JWS profiles",
  "$comment": "kid and iss are matched against deployment verifier configuration; cellOpsToken.privateOrigin is matched against the configured private origin for claims.cellId. The schema validates only their closed wire shapes.",
  "oneOf": [
    {
      "$ref": "#/$defs/relayToken"
    },
    {
      "$ref": "#/$defs/controlLease"
    },
    {
      "$ref": "#/$defs/clientAdmissionToken"
    },
    {
      "$ref": "#/$defs/cellOpsToken"
    }
  ],
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "epochSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "base64url16": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "base64url32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "relayHostId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16}$"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "canonicalHttpsOriginShape": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^https://[a-z0-9.-]+(?::[0-9]{1,5})?$"
    },
    "standardClaims": {
      "iss": {
        "$ref": "#/$defs/issuer"
      },
      "sub": {
        "$ref": "#/$defs/opaqueId"
      },
      "jti": {
        "$ref": "#/$defs/uuidV4"
      },
      "iat": {
        "$ref": "#/$defs/epochSeconds"
      },
      "nbf": {
        "$ref": "#/$defs/epochSeconds"
      },
      "exp": {
        "$ref": "#/$defs/epochSeconds"
      }
    },
    "relayToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenType",
        "header",
        "claims"
      ],
      "properties": {
        "tokenType": {
          "const": "relayToken"
        },
        "header": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alg",
            "typ",
            "kid"
          ],
          "properties": {
            "alg": {
              "const": "EdDSA"
            },
            "typ": {
              "const": "relay-assignment+jwt"
            },
            "kid": {
              "$ref": "#/$defs/kid"
            }
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "iss",
            "sub",
            "aud",
            "scope",
            "jti",
            "iat",
            "nbf",
            "exp",
            "runtimeTupleHash"
          ],
          "properties": {
            "iss": {
              "$ref": "#/$defs/issuer"
            },
            "sub": {
              "$ref": "#/$defs/opaqueId"
            },
            "aud": {
              "const": "hive-relay-director"
            },
            "scope": {
              "const": "relay:assign"
            },
            "jti": {
              "$ref": "#/$defs/uuidV4"
            },
            "iat": {
              "$ref": "#/$defs/epochSeconds"
            },
            "nbf": {
              "$ref": "#/$defs/epochSeconds"
            },
            "exp": {
              "$ref": "#/$defs/epochSeconds"
            },
            "runtimeTupleHash": {
              "$ref": "#/$defs/base64url32"
            }
          }
        }
      }
    },
    "controlLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenType",
        "header",
        "claims"
      ],
      "properties": {
        "tokenType": {
          "const": "controlLease"
        },
        "header": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alg",
            "typ",
            "kid"
          ],
          "properties": {
            "alg": {
              "const": "EdDSA"
            },
            "typ": {
              "const": "relay-control+jwt"
            },
            "kid": {
              "$ref": "#/$defs/kid"
            }
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "iss",
            "sub",
            "aud",
            "scope",
            "jti",
            "iat",
            "nbf",
            "exp",
            "cellId",
            "cellIncarnationId",
            "assignmentId",
            "relayHostId",
            "hostKeyHash",
            "runtimeTupleHash",
            "authorityGeneration",
            "fencingEpoch",
            "leaseEpoch",
            "assignmentEpoch",
            "controlGeneration"
          ],
          "properties": {
            "iss": {
              "$ref": "#/$defs/issuer"
            },
            "sub": {
              "$ref": "#/$defs/opaqueId"
            },
            "aud": {
              "const": "hive-relay-cell"
            },
            "scope": {
              "const": "relay:control"
            },
            "jti": {
              "$ref": "#/$defs/uuidV4"
            },
            "iat": {
              "$ref": "#/$defs/epochSeconds"
            },
            "nbf": {
              "$ref": "#/$defs/epochSeconds"
            },
            "exp": {
              "$ref": "#/$defs/epochSeconds"
            },
            "cellId": {
              "$ref": "#/$defs/opaqueId"
            },
            "cellIncarnationId": {
              "$ref": "#/$defs/uuidV4"
            },
            "assignmentId": {
              "$ref": "#/$defs/uuidV4"
            },
            "relayHostId": {
              "$ref": "#/$defs/relayHostId"
            },
            "hostKeyHash": {
              "$ref": "#/$defs/base64url32"
            },
            "runtimeTupleHash": {
              "$ref": "#/$defs/base64url32"
            },
            "authorityGeneration": {
              "$ref": "#/$defs/generation"
            },
            "fencingEpoch": {
              "$ref": "#/$defs/generation"
            },
            "leaseEpoch": {
              "$ref": "#/$defs/generation"
            },
            "assignmentEpoch": {
              "$ref": "#/$defs/generation"
            },
            "controlGeneration": {
              "$ref": "#/$defs/generation"
            }
          }
        }
      }
    },
    "clientAdmissionToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenType",
        "header",
        "claims"
      ],
      "properties": {
        "tokenType": {
          "const": "clientAdmissionToken"
        },
        "header": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alg",
            "typ",
            "kid"
          ],
          "properties": {
            "alg": {
              "const": "EdDSA"
            },
            "typ": {
              "const": "relay-client-admission+jwt"
            },
            "kid": {
              "$ref": "#/$defs/kid"
            }
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "iss",
            "sub",
            "aud",
            "scope",
            "jti",
            "iat",
            "nbf",
            "exp",
            "cellId",
            "cellIncarnationId",
            "assignmentId",
            "relayHostId",
            "intentId",
            "clientKeyHash",
            "runtimeTupleHash",
            "authorityGeneration",
            "fencingEpoch",
            "leaseEpoch",
            "assignmentEpoch"
          ],
          "properties": {
            "iss": {
              "$ref": "#/$defs/issuer"
            },
            "sub": {
              "$ref": "#/$defs/opaqueId"
            },
            "aud": {
              "const": "hive-relay-cell"
            },
            "scope": {
              "const": "relay:connect"
            },
            "jti": {
              "$ref": "#/$defs/uuidV4"
            },
            "iat": {
              "$ref": "#/$defs/epochSeconds"
            },
            "nbf": {
              "$ref": "#/$defs/epochSeconds"
            },
            "exp": {
              "$ref": "#/$defs/epochSeconds"
            },
            "cellId": {
              "$ref": "#/$defs/opaqueId"
            },
            "cellIncarnationId": {
              "$ref": "#/$defs/uuidV4"
            },
            "assignmentId": {
              "$ref": "#/$defs/uuidV4"
            },
            "relayHostId": {
              "$ref": "#/$defs/relayHostId"
            },
            "intentId": {
              "$ref": "#/$defs/uuidV4"
            },
            "clientKeyHash": {
              "$ref": "#/$defs/base64url32"
            },
            "runtimeTupleHash": {
              "$ref": "#/$defs/base64url32"
            },
            "authorityGeneration": {
              "$ref": "#/$defs/generation"
            },
            "fencingEpoch": {
              "$ref": "#/$defs/generation"
            },
            "leaseEpoch": {
              "$ref": "#/$defs/generation"
            },
            "assignmentEpoch": {
              "$ref": "#/$defs/generation"
            }
          }
        }
      }
    },
    "cellOpsToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenType",
        "header",
        "claims"
      ],
      "properties": {
        "tokenType": {
          "const": "cellOpsToken"
        },
        "header": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alg",
            "typ",
            "kid"
          ],
          "properties": {
            "alg": {
              "const": "EdDSA"
            },
            "typ": {
              "const": "relay-cell-ops+jwt"
            },
            "kid": {
              "$ref": "#/$defs/kid"
            }
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "iss",
            "sub",
            "aud",
            "scope",
            "jti",
            "iat",
            "nbf",
            "exp",
            "method",
            "path",
            "privateOrigin",
            "cellId",
            "nonce"
          ],
          "properties": {
            "iss": {
              "$ref": "#/$defs/issuer"
            },
            "sub": {
              "const": "hive-cloud-relay-ops"
            },
            "aud": {
              "const": "hive-relay-cell-ops"
            },
            "scope": {
              "enum": [
                "relay:cell:status",
                "relay:cell:lifecycle",
                "relay:cell:fence"
              ]
            },
            "jti": {
              "$ref": "#/$defs/uuidV4"
            },
            "iat": {
              "$ref": "#/$defs/epochSeconds"
            },
            "nbf": {
              "$ref": "#/$defs/epochSeconds"
            },
            "exp": {
              "$ref": "#/$defs/epochSeconds"
            },
            "method": {
              "enum": [
                "GET",
                "POST"
              ]
            },
            "path": {
              "enum": [
                "/internal/status",
                "/internal/v1/lifecycle",
                "/internal/v1/fences"
              ]
            },
            "privateOrigin": {
              "$ref": "#/$defs/canonicalHttpsOriginShape"
            },
            "cellId": {
              "$ref": "#/$defs/opaqueId"
            },
            "nonce": {
              "$ref": "#/$defs/base64url16"
            }
          },
          "oneOf": [
            {
              "properties": {
                "scope": {
                  "const": "relay:cell:status"
                },
                "method": {
                  "const": "GET"
                },
                "path": {
                  "const": "/internal/status"
                }
              }
            },
            {
              "properties": {
                "scope": {
                  "const": "relay:cell:lifecycle"
                },
                "method": {
                  "const": "POST"
                },
                "path": {
                  "const": "/internal/v1/lifecycle"
                }
              }
            },
            {
              "properties": {
                "scope": {
                  "const": "relay:cell:fence"
                },
                "method": {
                  "const": "POST"
                },
                "path": {
                  "const": "/internal/v1/fences"
                }
              }
            }
          ]
        }
      }
    }
  }
}
