{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hive.dev/hiverelay/v2/token-claims.schema.json",
  "title": "HiveRelay decoded strict JWS profiles",
  "oneOf": [
    {"$ref": "#/$defs/relayToken"},
    {"$ref": "#/$defs/controlLease"},
    {"$ref": "#/$defs/clientAdmissionToken"},
    {"$ref": "#/$defs/cellOpsToken"}
  ],
  "$defs": {
    "opaqueId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "uuidV4": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "epochSeconds": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "base64url16": {"type": "string", "pattern": "^[A-Za-z0-9_-]{22}$"},
    "base64url32": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "relayHostId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16}$"},
    "standardClaims": {
      "iss": {"const": "https://cloud.hive.test/relay"},
      "sub": {"$ref": "#/$defs/opaqueId"},
      "jti": {"$ref": "#/$defs/uuidV4"},
      "iat": {"$ref": "#/$defs/epochSeconds"},
      "nbf": {"$ref": "#/$defs/epochSeconds"},
      "exp": {"$ref": "#/$defs/epochSeconds"}
    },
    "relayToken": {
      "type": "object", "additionalProperties": false, "required": ["tokenType", "header", "claims"],
      "properties": {
        "tokenType": {"const": "relayToken"},
        "header": {"type": "object", "additionalProperties": false, "required": ["alg", "typ", "kid"], "properties": {"alg": {"const": "EdDSA"}, "typ": {"const": "relay-assignment+jwt"}, "kid": {"const": "relay-test-2026-01"}}},
        "claims": {
          "type": "object", "additionalProperties": false,
          "required": ["iss", "sub", "aud", "scope", "jti", "iat", "nbf", "exp", "runtimeTupleHash"],
          "properties": {
            "iss": {"const": "https://cloud.hive.test/relay"}, "sub": {"$ref": "#/$defs/opaqueId"}, "aud": {"const": "hive-relay-director"}, "scope": {"const": "relay:assign"},
            "jti": {"$ref": "#/$defs/uuidV4"}, "iat": {"$ref": "#/$defs/epochSeconds"}, "nbf": {"$ref": "#/$defs/epochSeconds"}, "exp": {"$ref": "#/$defs/epochSeconds"},
            "runtimeTupleHash": {"$ref": "#/$defs/base64url32"}
          }
        }
      }
    },
    "controlLease": {
      "type": "object", "additionalProperties": false, "required": ["tokenType", "header", "claims"],
      "properties": {
        "tokenType": {"const": "controlLease"},
        "header": {"type": "object", "additionalProperties": false, "required": ["alg", "typ", "kid"], "properties": {"alg": {"const": "EdDSA"}, "typ": {"const": "relay-control+jwt"}, "kid": {"const": "relay-test-2026-01"}}},
        "claims": {
          "type": "object", "additionalProperties": false,
          "required": ["iss", "sub", "aud", "scope", "jti", "iat", "nbf", "exp", "cellId", "cellIncarnationId", "assignmentId", "relayHostId", "hostKeyHash", "runtimeTupleHash", "authorityGeneration", "fencingEpoch", "leaseEpoch", "assignmentEpoch", "controlGeneration"],
          "properties": {
            "iss": {"const": "https://cloud.hive.test/relay"}, "sub": {"$ref": "#/$defs/opaqueId"}, "aud": {"const": "hive-relay-cell"}, "scope": {"const": "relay:control"},
            "jti": {"$ref": "#/$defs/uuidV4"}, "iat": {"$ref": "#/$defs/epochSeconds"}, "nbf": {"$ref": "#/$defs/epochSeconds"}, "exp": {"$ref": "#/$defs/epochSeconds"},
            "cellId": {"$ref": "#/$defs/opaqueId"}, "cellIncarnationId": {"$ref": "#/$defs/uuidV4"}, "assignmentId": {"$ref": "#/$defs/uuidV4"}, "relayHostId": {"$ref": "#/$defs/relayHostId"},
            "hostKeyHash": {"$ref": "#/$defs/base64url32"}, "runtimeTupleHash": {"$ref": "#/$defs/base64url32"},
            "authorityGeneration": {"$ref": "#/$defs/generation"}, "fencingEpoch": {"$ref": "#/$defs/generation"}, "leaseEpoch": {"$ref": "#/$defs/generation"}, "assignmentEpoch": {"$ref": "#/$defs/generation"}, "controlGeneration": {"$ref": "#/$defs/generation"}
          }
        }
      }
    },
    "clientAdmissionToken": {
      "type": "object", "additionalProperties": false, "required": ["tokenType", "header", "claims"],
      "properties": {
        "tokenType": {"const": "clientAdmissionToken"},
        "header": {"type": "object", "additionalProperties": false, "required": ["alg", "typ", "kid"], "properties": {"alg": {"const": "EdDSA"}, "typ": {"const": "relay-client-admission+jwt"}, "kid": {"const": "relay-test-2026-01"}}},
        "claims": {
          "type": "object", "additionalProperties": false,
          "required": ["iss", "sub", "aud", "scope", "jti", "iat", "nbf", "exp", "cellId", "cellIncarnationId", "assignmentId", "relayHostId", "intentId", "clientKeyHash", "runtimeTupleHash", "authorityGeneration", "fencingEpoch", "leaseEpoch", "assignmentEpoch"],
          "properties": {
            "iss": {"const": "https://cloud.hive.test/relay"}, "sub": {"$ref": "#/$defs/opaqueId"}, "aud": {"const": "hive-relay-cell"}, "scope": {"const": "relay:connect"},
            "jti": {"$ref": "#/$defs/uuidV4"}, "iat": {"$ref": "#/$defs/epochSeconds"}, "nbf": {"$ref": "#/$defs/epochSeconds"}, "exp": {"$ref": "#/$defs/epochSeconds"},
            "cellId": {"$ref": "#/$defs/opaqueId"}, "cellIncarnationId": {"$ref": "#/$defs/uuidV4"}, "assignmentId": {"$ref": "#/$defs/uuidV4"}, "relayHostId": {"$ref": "#/$defs/relayHostId"}, "intentId": {"$ref": "#/$defs/uuidV4"},
            "clientKeyHash": {"$ref": "#/$defs/base64url32"}, "runtimeTupleHash": {"$ref": "#/$defs/base64url32"},
            "authorityGeneration": {"$ref": "#/$defs/generation"}, "fencingEpoch": {"$ref": "#/$defs/generation"}, "leaseEpoch": {"$ref": "#/$defs/generation"}, "assignmentEpoch": {"$ref": "#/$defs/generation"}
          }
        }
      }
    },
    "cellOpsToken": {
      "type": "object", "additionalProperties": false, "required": ["tokenType", "header", "claims"],
      "properties": {
        "tokenType": {"const": "cellOpsToken"},
        "header": {"type": "object", "additionalProperties": false, "required": ["alg", "typ", "kid"], "properties": {"alg": {"const": "EdDSA"}, "typ": {"const": "relay-cell-ops+jwt"}, "kid": {"const": "relay-test-2026-01"}}},
        "claims": {
          "type": "object", "additionalProperties": false,
          "required": ["iss", "sub", "aud", "scope", "jti", "iat", "nbf", "exp", "method", "path", "privateOrigin", "cellId", "nonce"],
          "properties": {
            "iss": {"const": "https://cloud.hive.test/relay"}, "sub": {"const": "hive-cloud-relay-ops"}, "aud": {"const": "hive-relay-cell-ops"},
            "scope": {"enum": ["relay:cell:status", "relay:cell:lifecycle", "relay:cell:fence"]},
            "jti": {"$ref": "#/$defs/uuidV4"}, "iat": {"$ref": "#/$defs/epochSeconds"}, "nbf": {"$ref": "#/$defs/epochSeconds"}, "exp": {"$ref": "#/$defs/epochSeconds"},
            "method": {"enum": ["GET", "POST"]}, "path": {"enum": ["/internal/status", "/internal/v1/lifecycle", "/internal/v1/fences"]},
            "privateOrigin": {"const": "https://cell-01.private.hive.test:8443"}, "cellId": {"$ref": "#/$defs/opaqueId"}, "nonce": {"$ref": "#/$defs/base64url16"}
          }
        }
      }
    }
  }
}
