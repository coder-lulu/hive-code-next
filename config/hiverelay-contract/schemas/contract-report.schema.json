{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hive.dev/hiverelay/v2/contract-report.schema.json",
  "title": "HiveRelay component contract report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "component",
    "status",
    "commit",
    "contractRevision",
    "manifestSha256",
    "testCount",
    "resultCount",
    "applicableFixtureCount",
    "results",
    "errors"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "component": {
      "enum": [
        "cloud-java",
        "hivecode-typescript",
        "cell-elixir"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "containerImage": {
      "type": "string",
      "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
    },
    "contractRevision": {
      "const": "hiverelay-v2-p0.10"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "testCount": {
      "type": "integer",
      "minimum": 1
    },
    "resultCount": {
      "type": "integer",
      "minimum": 1
    },
    "applicableFixtureCount": {
      "type": "integer",
      "minimum": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elixirVersion",
        "otpRelease"
      ],
      "properties": {
        "elixirVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "otpRelease": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "verdict",
          "reason"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "verdict": {
            "enum": [
              "ACCEPT",
              "REJECT",
              "NOT_APPLICABLE"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "component": {
            "const": "cell-elixir"
          }
        },
        "required": [
          "component"
        ]
      },
      "then": {
        "required": [
          "containerImage",
          "runtime"
        ]
      }
    }
  ]
}
