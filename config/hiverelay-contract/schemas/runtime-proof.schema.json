{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hive.dev/hiverelay/v2/runtime-proof.schema.json",
  "title": "HiveRelay Runtime Cloud request proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion", "algorithm", "method", "path", "authorityId", "runtimeId",
    "runtimeBootId", "authorityGeneration", "fencingEpoch", "leaseEpoch", "issuedAt",
    "nonce", "bodySha256", "signature"
  ],
  "properties": {
    "protocolVersion": {"const": "hive-relay-runtime-proof/v2"},
    "algorithm": {"const": "Ed25519"},
    "method": {"enum": ["POST"]},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^/[^?#]*$"},
    "authorityId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "runtimeId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "runtimeBootId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "authorityGeneration": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "fencingEpoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "leaseEpoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "issuedAt": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "bodySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "$comment": "Carrier, JCS projection, current Runtime tuple, freshness, nonce replay, body digest, and signature checks are semantic rules in canonical-encoding.md."
}
