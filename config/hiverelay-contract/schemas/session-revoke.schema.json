{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hive.dev/hiverelay/v2/session-revoke.schema.json",
  "title": "HiveRelay account-owned managed session revocation",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}],
  "$defs": {
    "uuidV4": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positiveGeneration": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "operationId", "expectedResourceVersion"],
      "properties": {
        "protocolVersion": {"const": "account-runtime-session-revoke/v2"},
        "operationId": {"$ref": "#/$defs/uuidV4"},
        "expectedResourceVersion": {"$ref": "#/$defs/positiveGeneration"}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "operationId", "managedSessionId", "status", "resourceVersion", "controlVersion"],
      "properties": {
        "protocolVersion": {"const": "account-runtime-session-revoke/v2"},
        "operationId": {"$ref": "#/$defs/uuidV4"},
        "managedSessionId": {"$ref": "#/$defs/uuidV4"},
        "status": {"enum": ["REVOKE_PENDING", "CLOSED", "REVOKED", "EXPIRED", "UNVERIFIABLE"]},
        "resourceVersion": {"$ref": "#/$defs/positiveGeneration"},
        "controlVersion": {"$ref": "#/$defs/generation"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {"code": {"enum": ["INVALID_REQUEST", "CREDENTIAL_REJECTED", "NOT_FOUND", "STALE_BINDING", "COMMAND_REPLAY_CONFLICT", "RELAY_UNAVAILABLE"]}}
    }
  }
}
