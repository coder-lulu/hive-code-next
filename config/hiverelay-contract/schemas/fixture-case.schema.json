{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hive.dev/hiverelay/v2/fixture-case.schema.json",
  "title": "HiveRelay language-neutral fixture case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractRevision",
    "caseId",
    "suite",
    "operation",
    "applicableComponents",
    "validationTime",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractRevision": {
      "const": "hiverelay-v2-p0.7"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"
    },
    "suite": {
      "enum": ["hiverelay-v2-conformance"]
    },
    "operation": {
      "enum": [
        "wire-message",
        "jws",
        "runtime-proof",
        "runtime-tuple-hash",
        "origin",
        "x25519-key",
        "private-command",
        "private-status",
        "lifecycle-operator",
        "heartbeat-control",
        "heartbeat-error",
        "session-transition",
        "close-code",
        "frame-limit",
        "admission-replay",
        "conn-ticket-replay"
      ]
    },
    "applicableComponents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["cloud", "hivecode", "cell"]
      }
    },
    "validationTime": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "input": {
      "type": "object"
    }
  }
}
