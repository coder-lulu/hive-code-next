{
  "schemaVersion": 1,
  "contractRevision": "hiverelay-v2-p0.2",
  "clockSkewSeconds": 30,
  "credentials": [
    {
      "name": "runtimeProof",
      "issuer": "runtime-cloud-ed25519",
      "verifier": "hive-cloud",
      "carrier": "json-body.runtimeProof",
      "lifetimeSeconds": 60,
      "oneUse": true,
      "protocolVersion": "hive-relay-runtime-proof/v2",
      "algorithm": "Ed25519",
      "bodyEncoding": "RFC8785-JCS-with-top-level-runtimeProof-removed",
      "nonceDigestDomain": "hive-relay-runtime-proof-nonce/v2",
      "bindings": ["domain", "method", "path", "authorityId", "bodyDigest", "runtimeId", "runtimeBootId", "authorityGeneration", "fencingEpoch", "leaseEpoch", "nonce", "issuedAt"]
    },
    {
      "name": "relayToken",
      "issuer": "cloud-relay-ed25519",
      "verifier": "hive-relay-director",
      "carrier": "authorization-bearer",
      "lifetimeSeconds": 300,
      "typ": "relay-assignment+jwt",
      "aud": "hive-relay-director",
      "scope": "relay:assign",
      "oneUse": false,
      "bindings": ["runtimeTupleHash"]
    },
    {
      "name": "controlLease",
      "issuer": "cloud-relay-ed25519",
      "verifier": "selected-hive-cell",
      "carrier": "host-control-authorization-header",
      "lifetimeSeconds": 120,
      "typ": "relay-control+jwt",
      "aud": "hive-relay-cell",
      "scope": "relay:control",
      "oneUse": false,
      "bindings": ["cellId", "cellIncarnationId", "assignmentId", "relayHostId", "hostKeyHash", "runtimeTupleHash", "authorityGeneration", "fencingEpoch", "leaseEpoch", "assignmentEpoch", "controlGeneration"]
    },
    {
      "name": "clientAdmissionToken",
      "issuer": "cloud-relay-ed25519",
      "verifier": "selected-hive-cell",
      "carrier": "client-first-json-frame",
      "lifetimeSeconds": 45,
      "typ": "relay-client-admission+jwt",
      "aud": "hive-relay-cell",
      "scope": "relay:connect",
      "oneUse": true,
      "bindings": ["cellId", "cellIncarnationId", "assignmentId", "relayHostId", "intentId", "clientKeyHash", "runtimeTupleHash", "authorityGeneration", "fencingEpoch", "leaseEpoch", "assignmentEpoch"]
    },
    {
      "name": "cellOpsToken",
      "issuer": "cloud-relay-ed25519",
      "verifier": "selected-hive-cell-private-ops",
      "carrier": "private-https-authorization-header",
      "lifetimeSeconds": 30,
      "typ": "relay-cell-ops+jwt",
      "aud": "hive-relay-cell-ops",
      "operationProfiles": [
        {"scope": "relay:cell:status", "method": "GET", "path": "/internal/status"},
        {"scope": "relay:cell:lifecycle", "method": "POST", "path": "/internal/v1/lifecycle"},
        {"scope": "relay:cell:fence", "method": "POST", "path": "/internal/v1/fences"}
      ],
      "oneUse": true,
      "bindings": ["method", "path", "privateOrigin", "cellId", "nonce", "jti"]
    },
    {
      "name": "connTicket",
      "issuer": "cell-csprng",
      "verifier": "same-hive-cell-incarnation",
      "carrier": "host-data-first-json-frame",
      "lifetimeSeconds": 12,
      "bytes": 32,
      "oneUse": true,
      "bindings": ["connId", "cellIncarnationId", "assignmentId", "assignmentEpoch", "controlGeneration"]
    },
    {
      "name": "businessTicketSecret",
      "issuer": "client-csprng",
      "verifier": "hive-cloud-via-runtime-e2ee",
      "carrier": "client-runtime-e2ee-inner-only",
      "lifetimeSeconds": 60,
      "bytes": 32,
      "oneUse": true,
      "cloudStorage": "sha256-digest-only",
      "bindings": ["intentId", "ticketId", "runtimeTupleHash", "assignmentId", "assignmentEpoch", "clientKeyHash"]
    }
  ],
  "keyPurposes": [
    "cloud-relay-ed25519",
    "hive-session-ed25519",
    "runtime-cloud-ed25519",
    "host-x25519",
    "client-ephemeral-x25519"
  ],
  "keyRotation": {
    "steps": ["ADD_VERIFIER", "CONFIRM_CELLS", "SWITCH_ACTIVE_SIGNER", "WAIT_330_SECONDS", "REMOVE_OLD_VERIFIER"],
    "activeSignerMustBeAccepted": true
  }
}
