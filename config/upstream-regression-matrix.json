{
  "schemaVersion": 2,
  "description": "Run focused platform contracts on each OS; the common job owns the broad unit, build, and mobile checks once.",
  "platforms": {
    "windows": {
      "suites": ["platform"],
      "checks": [
        {
          "id": "windows-cli-typecheck",
          "category": "platform",
          "kind": "command",
          "cwd": ".",
          "argv": ["pnpm", "run", "typecheck:cli"]
        }
      ]
    },
    "macos": { "suites": ["platform"], "checks": [] },
    "linux": { "suites": ["platform"], "checks": [] }
  },
  "criticalAreas": [
    "session reconnect",
    "host authority",
    "WSL",
    "SSH",
    "mobile relay",
    "Codex trust",
    "Windows launcher"
  ]
}
