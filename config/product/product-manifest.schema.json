{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HiveCode product manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "displayName",
    "shortName",
    "slug",
    "branding",
    "publicLinks",
    "cli",
    "schemes",
    "desktop",
    "mobile",
    "endpoints",
    "services"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "shortName": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logoAsset", "logoSha256"],
      "properties": {
        "logoAsset": { "type": "string", "pattern": "^resources/[A-Za-z0-9._/-]+$" },
        "logoSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "publicLinks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "website",
        "documentation",
        "support",
        "community",
        "social",
        "desktopDownload",
        "androidDownload",
        "iosDownload",
        "privacyPolicy",
        "termsOfService"
      ],
      "properties": {
        "website": { "type": ["string", "null"], "format": "uri" },
        "documentation": { "type": ["string", "null"], "format": "uri" },
        "support": { "type": ["string", "null"], "format": "uri" },
        "community": { "type": ["string", "null"], "format": "uri" },
        "social": { "type": ["string", "null"], "format": "uri" },
        "desktopDownload": { "type": ["string", "null"], "format": "uri" },
        "androidDownload": { "type": ["string", "null"], "format": "uri" },
        "iosDownload": { "type": ["string", "null"], "format": "uri" },
        "privacyPolicy": { "type": ["string", "null"], "format": "uri" },
        "termsOfService": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "cli": {
      "$ref": "#/$defs/compatibilityNames",
      "properties": {
        "primary": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
        }
      }
    },
    "schemes": {
      "$ref": "#/$defs/compatibilityNames",
      "properties": {
        "primary": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*$" },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*$" }
        }
      }
    },
    "desktop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "executableName",
        "publisher",
        "updateProvider",
        "updateChannel",
        "updateRepository",
        "starRepository"
      ],
      "properties": {
        "appId": { "$ref": "#/$defs/nullableString" },
        "executableName": { "type": "string", "minLength": 1 },
        "publisher": { "$ref": "#/$defs/nullableString" },
        "updateProvider": {
          "type": ["string", "null"],
          "enum": ["github", "hivecloud", null]
        },
        "updateChannel": {
          "type": ["string", "null"],
          "enum": ["internal", "stable", "beta", "rc", null]
        },
        "updateRepository": { "$ref": "#/$defs/nullableString" },
        "starRepository": { "$ref": "#/$defs/nullableString" }
      }
    },
    "mobile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleId", "packageId"],
      "properties": {
        "bundleId": { "$ref": "#/$defs/nullableString" },
        "packageId": { "$ref": "#/$defs/nullableString" }
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "cloud",
        "identityIssuer",
        "relay",
        "update",
        "telemetry",
        "diagnostics",
        "feedback",
        "pluginKillList",
        "pluginMarketplace",
        "changelog",
        "nudge"
      ],
      "properties": {
        "artifacts": { "$ref": "#/$defs/nullableUrl" },
        "cloud": { "$ref": "#/$defs/nullableUrl" },
        "identityIssuer": { "$ref": "#/$defs/nullableUrl" },
        "relay": { "$ref": "#/$defs/nullableUrl" },
        "update": { "$ref": "#/$defs/nullableUrl" },
        "telemetry": { "$ref": "#/$defs/nullableUrl" },
        "diagnostics": { "$ref": "#/$defs/nullableUrl" },
        "feedback": { "$ref": "#/$defs/nullableUrl" },
        "pluginKillList": { "$ref": "#/$defs/nullableUrl" },
        "pluginMarketplace": { "$ref": "#/$defs/nullableUrl" },
        "changelog": { "$ref": "#/$defs/nullableUrl" },
        "nudge": { "$ref": "#/$defs/nullableUrl" }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "identity", "oss", "update", "relay"],
      "properties": {
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseUrl"],
          "properties": { "baseUrl": { "$ref": "#/$defs/requiredUrl" } }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "clients"],
          "properties": {
            "issuer": { "$ref": "#/$defs/requiredUrl" },
            "clients": {
              "type": "object",
              "additionalProperties": false,
              "required": ["desktop", "userWeb", "operatorWeb"],
              "properties": {
                "desktop": { "type": "string", "minLength": 1 },
                "userWeb": { "type": "string", "minLength": 1 },
                "operatorWeb": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "oss": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "endpoint", "provider"],
          "properties": {
            "enabled": { "type": "boolean" },
            "endpoint": { "$ref": "#/$defs/nullableUrl" },
            "provider": { "$ref": "#/$defs/nullableString" }
          }
        },
        "update": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "endpoint", "checkEndpoint", "provider", "channel", "checkIntervalHours"],
          "properties": {
            "enabled": { "type": "boolean" },
            "endpoint": { "$ref": "#/$defs/nullableUrl" },
            "checkEndpoint": { "$ref": "#/$defs/nullableUrl" },
            "provider": { "type": ["string", "null"], "enum": ["github", "hivecloud", null] },
            "channel": { "type": ["string", "null"], "enum": ["internal", "stable", "beta", "rc", null] },
            "checkIntervalHours": { "type": "number", "minimum": 1, "maximum": 168 }
          }
        },
        "relay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "directorUrl"],
          "properties": {
            "enabled": { "type": "boolean" },
            "directorUrl": { "$ref": "#/$defs/nullableUrl" }
          }
        }
      }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableUrl": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "requiredUrl": {
      "type": "string",
      "minLength": 1,
      "format": "uri"
    },
    "compatibilityNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "aliases"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
