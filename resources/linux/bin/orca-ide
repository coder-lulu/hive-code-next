#!/usr/bin/env bash
# This launcher must remain LF-only; it is executed directly from the Linux package.
set -euo pipefail

# Why: `orca-ide` remains a safe Linux compatibility command; resolve symlinks
# so APP_DIR points at the real HiveCode install, not the symlink's parent.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
	DIR="$(cd "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
	SOURCE="$(readlink "$SOURCE")"
	[[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
RESOURCES_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
APP_DIR="$(cd "$RESOURCES_DIR/.." >/dev/null 2>&1 && pwd)"

ELECTRON=""
for candidate in hivecode HiveCode orca-ide orca Orca; do
	if [ -f "$APP_DIR/$candidate" ] && [ -x "$APP_DIR/$candidate" ]; then
		ELECTRON="$APP_DIR/$candidate"
		break
	fi
done

if [ -z "$ELECTRON" ]; then
	echo "Unable to locate the HiveCode executable next to $RESOURCES_DIR" >&2
	exit 1
fi

# Why: HiveCode packages the CLI entrypoint outside app.asar so compatibility
# commands execute the same audited implementation as the canonical command.
CLI="$RESOURCES_DIR/app.asar.unpacked/out/cli/index.js"

export ORCA_NODE_OPTIONS="${NODE_OPTIONS-}"
export ORCA_NODE_REPL_EXTERNAL_MODULE="${NODE_REPL_EXTERNAL_MODULE-}"
export HIVE_CLI_INVOKED_AS="${0##*/}"
unset NODE_OPTIONS
unset NODE_REPL_EXTERNAL_MODULE

ELECTRON_RUN_AS_NODE=1 exec "$ELECTRON" "$CLI" "$@"
