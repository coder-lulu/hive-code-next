  "bindingCases": [
    {
      "name": "artifact revision changes invalidate old tests",
      "target": "review",
      "path": ["artifact", "artifactRevision"],
      "value": 2,
      "expected": "workflow_artifact_revision_mismatch"
    },
    {
      "name": "artifact digest changes invalidate old tests",
      "target": "review",
      "path": ["artifact", "digest"],
      "value": "3333333333333333333333333333333333333333333333333333333333333333",
      "expected": "workflow_artifact_revision_mismatch"
    },
    {
      "name": "code tree changes invalidate old tests",
      "target": "review",
      "path": ["codeVersion", "treeDigest"],
      "value": "4444444444444444444444444444444444444444444444444444444444444444",
      "expected": "workflow_artifact_revision_mismatch"
    },
    {
      "name": "workflow revision cannot drift in flight",
      "target": "review",
      "path": ["binding", "workflowRevision"],
      "value": 2,
      "expected": "workflow_binding_mismatch"
    },
    {
      "name": "project cannot be substituted",
      "target": "review",
      "path": ["binding", "scope", "projectRef"],
      "value": "project:other",
      "expected": "workflow_binding_mismatch"
    },
    {
      "name": "producer session cannot perform independent tests",
      "target": "review",
      "path": ["reviewer", "sessionRef"],
      "value": "session:developer",
      "expected": "workflow_independent_test_required"
    },
    {
      "name": "producer workspace cannot perform independent tests",
      "target": "review",
      "path": ["reviewer", "executionWorkspaceRef"],
      "value": "execution-workspace:developer",
      "expected": "workflow_independent_test_required"
    },
    {
      "name": "producer execution cannot perform independent tests",
      "target": "review",
      "path": ["reviewer", "executionId"],
      "value": "execution:developer",
      "expected": "workflow_independent_test_required"
    },
    {
      "name": "deployment approval must match artifact revision",
      "target": "approval",
      "path": ["artifact", "artifactRevision"],
      "value": 2,
      "expected": "workflow_artifact_revision_mismatch"
    },
    {
      "name": "deployment approval cannot follow a new workflow revision",
      "target": "approval",
      "path": ["binding", "workflowRevision"],
      "value": 2,
      "expected": "workflow_binding_mismatch"
    },
    {
      "name": "staging approval cannot authorize production",
      "target": "approval",
      "path": ["targetRef"],
      "value": "target:production",
      "expected": "workflow_deployment_authorization_mismatch"
    },
    {
      "name": "deploy approval cannot authorize rollback",
      "target": "approval",
      "path": ["action"],
      "value": "rollback",
      "expected": "workflow_deployment_authorization_mismatch"
    },
    {
      "name": "expired approval does not authorize a deployment",
      "target": "approval",
      "path": ["expiresAt"],
      "value": "2026-10-03T10:00:00.000Z",
      "expected": "workflow_deployment_authorization_mismatch"
    },
    {
      "name": "revoked authorization revision cannot be reused",
      "target": "approval",
      "path": ["authorizationRevision"],
      "value": "2",
      "expected": "workflow_deployment_authorization_mismatch"
    },
    {
      "name": "approval cannot be borrowed from another actor",
      "target": "approval",
      "path": ["actorRef"],
      "value": "actor:other",
      "expected": "workflow_deployment_authorization_mismatch"
    }
  ]
}
