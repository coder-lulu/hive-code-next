{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-project.github.io/refs/heads/json-schemas/oxfmt/v0.41.0/config.json",
  "singleQuote": true,
  "semi": false,
  "printWidth": 100,
  "trailingComma": "none",
  "ignorePatterns": [
    "cloud/**",
    "resources/licenses/**",
    ".github/actions/cloud-sql-rollout-lease/**",
    "config/hiverelay-contract/**",
    ".anti-slop-plugin/**",
    "runtime/managed-pi/legal/node-LICENSE",
    "runtime/managed-pi/legal/pi-LICENSE",
    "src/main/runtime/__fixtures__/*.timing.json",
    "docs/**"
  ]
}
