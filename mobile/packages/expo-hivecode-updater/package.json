{
  "name": "@hivecode/expo-hivecode-updater",
  "version": "0.0.1",
  "private": true,
  "description": "Minimal native bridge for handing verified HiveCode APKs to Android Package Installer",
  "keywords": [
    "ExpoHiveCodeUpdater",
    "expo",
    "android",
    "apk"
  ],
  "license": "MIT",
  "author": "HiveCode contributors",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "clean": "expo-module clean",
    "dev": "expo-module build",
    "lint": "expo-module lint",
    "test": "expo-module test",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "pnpm --dir ../.. exec tsc --noEmit",
    "expo-module": "expo-module"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "expo-module-scripts": "^55.0.2",
    "expo-modules-core": "^55.0.25"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
